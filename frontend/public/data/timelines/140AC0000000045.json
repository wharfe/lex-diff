  "explainer": {
    "generated_on": "2026-10-18",
    "recent_changes": [
      {
        "year": "2025",
        "enforcement_date": "2025-06-12",
        "diff_id": "140AC0000000045_2025-06-11_2025-06-12",
        "title": "文書偽造・印章偽造の罪等における電磁的記録の処罰対象化",
        "what": "公文書・私文書の偽造罪や印章偽造の罪に電磁的記録（電子データ）による偽造・不正使用が加えられ、公務用コンピュータへの妨害行為を罰する規定も新設されました。",
        "grounded": true,
        "why": "紙の文書を前提としていた従来の規定では、電子データを使った偽造行為や行政のコンピュータへの妨害に対応できなかったためです。",
        "impact": "電子申請や電子契約などで文書を偽造する行為が紙の文書と同様に処罰され、行政システムへの妨害行為も明確に罰せられるようになります。"
      },
      {
        "year": "2025",
        "enforcement_date": "2025-06-01",
        "diff_id": "140AC0000000045_2025-05-31_2025-06-01",
        "title": "懲役・禁錮の「拘禁刑」への一本化",
        "what": "刑法上の「懲役」と「禁錮」が廃止され「拘禁刑」に統一され、作業に加えて改善更生のための指導も行えるようになりました。執行猶予に関する規定も整備されました。",
        "grounded": true,
        "why": "受刑者の処遇や更生支援をより充実させる趣旨がうかがえます。",
        "impact": "裁判で言い渡される刑の種類が「拘禁刑」に一本化され、受刑者には作業だけでなく個別の指導も行われるようになります。"
      },
      {
        "year": "2023",
        "enforcement_date": "2023-07-13",
        "diff_id": "140AC0000000045_2023-07-12_2023-07-13",
        "title": "性犯罪規定の見直し（不同意わいせつ罪・不同意性交等罪への再構成）",
        "what": "暴行・脅迫を要件としていた強制わいせつ・強制性交等の罪が、同意しない意思の形成等が困難な状況を列挙した不同意わいせつ罪・不同意性交等罪に改められ、子どもへのわいせつ目的面会要求等も新たに処罰対象となりました。",
        "grounded": true,
        "why": "暴行・脅迫の有無を中心とする従来の要件では被害の実態に即した処罰が難しいという問題意識があったためです。",
        "impact": "恐怖や地位の悪用など具体的な状況に基づいて性犯罪が処罰されるようになり、子どもへのわいせつ目的の接触行為への保護も強化されます。"
      }
    ]
  }
